   author = {Tomohiro Inoue and Yucan Chen and Toshio Ohyanagi},
   title = {Assessing Handwriting Skills in a Web Browser: Development and Validation of an Automated Online Test in Japanese Kanji},
   url = {https://orcid.org/0000-0001-8163-087X}
